{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kapi",
  "version": "0.9.5",
  "identifier": "app.kapi.deskpet",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pet", "title": "Kapi", "url": "index.html",
        "width": 360, "height": 480,
        "transparent": true, "decorations": false, "shadow": false,
        "alwaysOnTop": true, "skipTaskbar": true, "resizable": false,
        "acceptFirstMouse": true, "visibleOnAllWorkspaces": true
      },
      {
        "label": "notebook", "title": "Kapi", "url": "panel.html",
        "width": 560, "height": 640, "minWidth": 420, "minHeight": 480,
        "visible": false, "resizable": true, "decorations": true, "alwaysOnTop": false, "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": { "allow": ["**/*"], "requireLiteralLeadingDot": false } }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Entertainment",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [ { "ext": ["petpack", "capapet"], "name": "Kapi pet package", "description": "Kapi pet package", "role": "Editor" } ],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
